#!/bin/bash
# VylarisSpace package guard.
#
# dpkg runs this script from the INSTALLED package as "prerm upgrade <new-version>" before it
# unpacks a package of the same name over it. The control data of the new package is already
# extracted at that point. If the new package is not a VylarisSpace package (it has no
# Vylaris-Edition field, for example the upstream hestia package), the script refuses, dpkg stops
# and the installed files stay in place. Without this a plain "dpkg -i" or
# "apt-get install hestia=<version>" of the upstream package would remove the VylarisSpace
# themes, logos, fonts and update scripts.
#
# Everything else (remove, purge, deconfigure, failed-upgrade, abort-*) is allowed.
# Deliberate override: touch /etc/hestiacp/allow-foreign-hestia (removed again when the next
# VylarisSpace package is configured), VYLARIS_ALLOW_FOREIGN_HESTIA=yes, or UPSTREAM_UPDATES='yes'
# in hestia.conf.

case "${1:-}" in
	upgrade) ;;
	*) exit 0 ;;
esac

new_version="${2:-}"
[ -f /etc/hestiacp/allow-foreign-hestia ] && exit 0
[ "${VYLARIS_ALLOW_FOREIGN_HESTIA:-}" = "yes" ] && exit 0
grep -qs "^UPSTREAM_UPDATES='yes'" /usr/local/hestia/conf/hestia.conf && exit 0

# dpkg extracts the control data of the new package to <admindir>/tmp.ci before this script runs
new_control="${DPKG_ADMINDIR:-/var/lib/dpkg}/tmp.ci/control"
if [ -r "$new_control" ]; then
	grep -qi '^Vylaris-Edition:[[:space:]]*[^[:space:]]' "$new_control" && exit 0
	reason="its control file has no Vylaris-Edition field"
else
	# Control data not readable (not expected). Fall back to the revision: own builds are -100
	# and higher, upstream builds are -1.
	if [[ "$new_version" =~ -[1-9][0-9]{2,}([+~]|$) ]]; then
		exit 0
	fi
	reason="its version '$new_version' is not a VylarisSpace build"
fi

app_name=$(sed -n "s/^APP_NAME='\(.*\)'\$/\1/p" /usr/local/hestia/conf/hestia.conf 2> /dev/null | head -n1)
app_name="${app_name:-${APP_NAME:-VylarisSpace}}"

cat >&2 << MSG

REFUSED: the package that is about to replace the installed 'hestia' is not a ${app_name} package ($reason).
It would remove the ${app_name} themes, logos, fonts and update scripts and bring back the upstream interface.
The installed ${app_name} package stays in place. Your settings, data and websites are not touched.
If you really want this, run: touch /etc/hestiacp/allow-foreign-hestia   and repeat the installation.

MSG
exit 1

#!/bin/bash
# Add php dependencies to Hestia
# options: [MODE]
#
# This function installs the PHP dependencies of the panel (PHPMailer, quoteshellarg,
# two-factor authentication, QR code, ...) via composer.
#
# The VylarisSpace package ships these dependencies ready to use in
# web/inc/vendor and web/src/vendor. When a vendor folder is complete (it holds every
# package of composer.lock in the locked version) it is left alone and neither
# Composer nor any network access is needed. On a source install, or when a vendor
# folder is missing or incomplete, the dependencies are installed with composer.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# upgrade config file
source "$HESTIA/install/upgrade/upgrade.conf"

MODE=$1
user="$ROOT_USER"
app_name="${APP_NAME:-VylarisSpace}"

PM_INSTALL_DIR="$HESTIA/web/inc"
QUICK_INSTALL_DIR="$HESTIA/web/src"
COMPOSER_BIN="$HOMEDIR/$user/.composer/composer"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking root permissions
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: v-add-sys-dependencies can be run executed only by root user"
	exit 10
fi

# Ensure that $HESTIA (/usr/local/hestia/) and other variables are valid.
if [ -z "$HESTIA" ]; then
	HESTIA="/usr/local/hestia"
fi

if [ -z "$HOMEDIR" ] || [ -z "$HESTIA_INSTALL_DIR" ]; then
	echo "ERROR: Environment variables not present, installation aborted."
	exit 2
fi

#----------------------------------------------------------#
#                Functions                                 #
#----------------------------------------------------------#

# Succeeds when <dir>/vendor holds every package of <dir>/composer.lock (non-dev) in
# exactly the locked version, plus the composer autoloader.
vendor_complete() {
	local dir=$1
	local lock="$dir/composer.lock"
	local installed="$dir/vendor/composer/installed.json"
	local name

	[ -f "$dir/vendor/autoload.php" ] || return 1
	[ -f "$lock" ] && [ -f "$installed" ] || return 1
	command -v jq > /dev/null 2>&1 || return 1

	# Locked packages that are not installed in the locked version
	local wrong
	wrong=$(jq -rs '
		((.[1].packages // []) | map({(.name): .version}) | add // {}) as $inst
		| [(.[0].packages // [])[] | select($inst[.name] != .version) | .name] | length
	' "$lock" "$installed" 2> /dev/null) || return 1
	[ "$wrong" = "0" ] || return 1

	# Every locked package has to exist on disk
	while IFS= read -r name; do
		[ -n "$name" ] || continue
		[ -d "$dir/vendor/$name" ] || return 1
	done < <(jq -r '(.packages // [])[].name' "$lock" 2> /dev/null)
	return 0
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Serialize runs, they share vendor.new / vendor.old
exec 9> /run/hestia-sys-dependencies.lock
check_result $? "Unable to create dependencies lock file"
flock -w 600 9
check_result $? "Unable to acquire dependencies lock"

# Only the folders without a complete vendor need Composer
pending_dirs=()
for dir in "$PM_INSTALL_DIR" "$QUICK_INSTALL_DIR"; do
	if ! vendor_complete "$dir"; then
		pending_dirs+=("$dir")
	fi
done

if [ ${#pending_dirs[@]} -eq 0 ]; then
	echo "PHP dependencies are already complete, Composer is not needed."
	$BIN/v-log-action "system" "Info" "Plugins" "PHP dependencies already complete, nothing to install"
	log_event "$OK" "$ARGUMENTS"
	exit 0
fi

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

# Ensure that Composer is installed for the user before continuing as it is a dependency of the PHPMailer.
if [ ! -f "$COMPOSER_BIN" ]; then
	$BIN/v-add-user-composer "$user"
	if [ $? -ne 0 ]; then
		$BIN/v-add-user-notification "$ROOT_USER" 'Composer installation failed!' '<p class="u-text-bold">'"$app_name"' will not work without Composer.</p><p>Please try running the installer manually from a shell session:<br><code>v-add-sys-dependencies</code></p>'
		exit 1
	fi
fi

openssl_installed=$(/usr/local/hestia/php/bin/php -m | grep openssl)

# Install the dependencies of $1 into $1/vendor.new and only replace $1/vendor
# once that succeeded, so a failed install (e.g. a network timeout) keeps the
# previous, working dependencies instead of leaving the panel without them
install_dependencies() {
	local dir=$1
	rm --recursive --force "$dir/vendor.new"
	mkdir -p "$dir/vendor.new"
	chown $user: "$dir/vendor.new"

	cd "$dir" || return 1
	if [ -z "$openssl_installed" ]; then
		COMPOSER_HOME="$HOMEDIR/$user/.config/composer" COMPOSER_VENDOR_DIR="$dir/vendor.new" user_exec /usr/bin/php $COMPOSER_BIN --quiet --no-dev install
	else
		COMPOSER_HOME="$HOMEDIR/$user/.config/composer" COMPOSER_VENDOR_DIR="$dir/vendor.new" user_exec $HESTIA_PHP $COMPOSER_BIN --quiet --no-dev install
	fi
	if [ $? -ne 0 ] || [ ! -f "$dir/vendor.new/autoload.php" ]; then
		rm --recursive --force "$dir/vendor.new"
		return 1
	fi

	chown root: -R "$dir/vendor.new"
	rm --recursive --force "$dir/vendor.old"
	if [ -d "$dir/vendor" ]; then
		mv "$dir/vendor" "$dir/vendor.old" || return 1
	fi
	if ! mv "$dir/vendor.new" "$dir/vendor"; then
		if [ -d "$dir/vendor.old" ]; then
			mv "$dir/vendor.old" "$dir/vendor"
		fi
		rm --recursive --force "$dir/vendor.new"
		return 1
	fi
	rm --recursive --force "$dir/vendor.old"
}

# Check if installation was successful, if not abort script and throw error message notification
if [[ " ${pending_dirs[*]} " == *" $PM_INSTALL_DIR "* ]] && ! install_dependencies "$PM_INSTALL_DIR"; then
	echo "ERROR: PHPMailer installation failed!"
	$BIN/v-add-user-notification "$ROOT_USER" 'PHP dependencies installation failed!' '<p>The PHP dependencies required by '"$app_name"' could not be installed. Please check the system log for details.</p>'
	if [ -f "$PM_INSTALL_DIR/vendor/autoload.php" ]; then
		echo "The previously installed PHP dependencies have been kept."
	else
		$BIN/v-change-sys-config-value 'USE_SERVER_SMTP' 'n'
	fi
	$BIN/v-log-action "system" "Error" "Plugins" "PHP dependencies installation failed"
	exit 1
fi

if [[ " ${pending_dirs[*]} " == *" $QUICK_INSTALL_DIR "* ]] && ! install_dependencies "$QUICK_INSTALL_DIR"; then
	echo "ERROR: Quick install dependencies installation failed!"
	$BIN/v-add-user-notification "$ROOT_USER" 'Quick Install dependencies installation failed!' '<p>The Quick Install dependencies required by '"$app_name"' could not be installed. Please check the system log for details.</p>'
	if [ -f "$QUICK_INSTALL_DIR/vendor/autoload.php" ]; then
		echo "The previously installed Quick Install dependencies have been kept."
	fi
	$BIN/v-log-action "system" "Error" "Plugins" "Quick Install dependencies installation failed"
	exit 1
fi

#----------------------------------------------------------#
#                       Logging                            #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "Plugins" "PHP dependencies installed"
log_event "$OK" "$ARGUMENTS"
